# Copy to ignored .dev.vars and add a server-side credential.
# xAI (Grok): https://console.x.ai/ — not promised free; confirm account billing.
# Groq: https://console.groq.com/ — separate service/key; account limits apply.
# Never paste keys into chat or commit them. Restart the dev server after saving.
AI_PROVIDER="gemini"
# Gemini: https://aistudio.google.com/apikey — server-side only.
# Limited free tier; Google marks free-tier inputs as used to improve products.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_VISUAL_MODEL=""
XAI_API_KEY=""
XAI_MODEL="grok-4.20-0309-non-reasoning"
XAI_VISUAL_MODEL=""
GROQ_API_KEY=""
# This current Groq vision + structured-output model is marked preview.
GROQ_MODEL="qwen/qwen3.8-27b"
GROQ_VISUAL_MODEL=""
# Optional distinct configured provider; never retries by rotating provider keys.
AI_FALLBACK_PROVIDER=""

