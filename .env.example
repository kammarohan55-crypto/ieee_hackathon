# Optional live AI, server-side only. Rules and weather work without a key.
# Use .dev.vars locally; configure secrets in the deployment's Worker environment.
# xAI (Grok) and Groq are separate services with separate credentials and billing.
AI_PROVIDER=gemini
# Gemini: https://aistudio.google.com/apikey — server-side only.
# Limited free tier; Google marks free-tier inputs as used to improve products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_VISUAL_MODEL=
XAI_API_KEY=
XAI_MODEL=grok-4.20-0309-non-reasoning
# Optional visual override; otherwise XAI_MODEL is used.
XAI_VISUAL_MODEL=
GROQ_API_KEY=
# Groq labels this current vision + structured-output model preview.
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_VISUAL_MODEL=
# Optional distinct provider (gemini, xai or groq) with its own configured key.
# May receive consented evidence once if the primary has an availability failure.
AI_FALLBACK_PROVIDER=

